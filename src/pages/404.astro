---
// Ruta: src/pages/404.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import { COMUNIDADES } from '../lib/festivos';
---

<BaseLayout title="Página no encontrada" description="Esta página no existe. Elige tu comunidad o vuelve a la portada." noindex>
  <section class="mx-auto max-w-3xl px-4 py-20 text-center sm:px-6">
    <p class="text-sm font-semibold text-indigo-700">Error 404</p>
    <h1 class="mt-2 text-4xl font-extrabold tracking-tight text-slate-900">Este día no está en el calendario</h1>
    <p class="mt-4 text-lg text-slate-600">La página que buscas no existe. Elige tu comunidad o prueba el optimizador.</p>
    <ul class="mt-8 flex flex-wrap justify-center gap-2 text-sm">
      {COMUNIDADES.map((c) => <li><a href={`/calendario-laboral-2027/${c.slug}`} class="rounded-full border border-slate-200 bg-white px-3 py-1.5 hover:border-indigo-300">{c.corto}</a></li>)}
    </ul>
    <a href="/vacaciones" class="boton mt-10">Planifica tus vacaciones</a>
  </section>
</BaseLayout>
