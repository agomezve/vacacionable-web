---
// Ruta: src/pages/herramientas.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import CabeceraPagina from '../components/CabeceraPagina.astro';
import Icono from '../components/Icono.astro';
import { HERRAMIENTAS } from '../config/site';

const grupos = [...new Set(HERRAMIENTAS.map((h) => h.grupo))];
const breadcrumbs = [{ name: 'Herramientas' }];
---

<BaseLayout title="Todas las herramientas de festivos y vacaciones 2027" description="Optimizador de vacaciones, puentes, calendarios por comunidad, cuenta atrás, comparadores y guías sobre vacaciones y festivos." breadcrumbs={breadcrumbs}>
  <CabeceraPagina titulo="Todas las herramientas" breadcrumbs={breadcrumbs}>
    <p>{HERRAMIENTAS.length} herramientas y guías, todas gratis y sin registro.</p>
  </CabeceraPagina>
  <div class="mx-auto max-w-6xl space-y-10 px-4 py-10 sm:px-6">
    {
      grupos.map((g) => (
        <section>
          <h2 class="text-2xl font-bold tracking-tight text-slate-900">{g}</h2>
          <ul class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
            {HERRAMIENTAS.filter((h) => h.grupo === g).map((h, i) => (
              <li class="aparece" style={`transition-delay:${i * 50}ms`}>
                <a href={h.href} class="group flex h-full gap-4 rounded-2xl border border-slate-200 bg-white p-5 transition hover:-translate-y-1 hover:border-indigo-300 hover:shadow-lg">
                  <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl bg-gradient-to-br from-indigo-500 to-violet-600 text-white shadow-md shadow-indigo-500/30 transition group-hover:rotate-6 group-hover:scale-110">
                    <Icono nombre={h.icono} />
                  </span>
                  <span>
                    <span class="block font-bold text-slate-900">{h.titulo}</span>
                    <span class="mt-1 block text-sm leading-snug text-slate-600">{h.texto}</span>
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>
</BaseLayout>
