---
// Ruta: src/pages/puentes-2027/[puente].astro
// Idea 16 (una página por puente) + 20 (vuelos y alojamiento para esas fechas en ViajaChollo).
import BaseLayout from '../../layouts/BaseLayout.astro';
import CabeceraPagina from '../../components/CabeceraPagina.astro';
import { ANIO, COMUNIDADES, FUENTE_BOE, festivos, puentes, calendario, fmtLargo, fmtRango, fmtMini, nombreDia } from '../../lib/festivos';
import { anioHtml, rango, type Marca } from '../../lib/calendario-html';
import { PUENTES_2027 } from '../../data/puentes';
import { puenteDe } from '../../lib/puente-html';
import { CONTEXT_LINKS, getProject } from '../../config/site';

export function getStaticPaths() {
  return PUENTES_2027.map((f) => ({ params: { puente: f.slug }, props: { f } }));
}
const { f } = Astro.props;
const filas = COMUNIDADES.map((c) => {
  const lista = festivos(c.slug, ANIO);
  return { c, lista, p: puenteDe(f, puentes(ANIO, lista)) };
});
// Agrupa las comunidades con el mismo resultado.
const grupos = new Map<string, { comunidades: string[]; p: (typeof filas)[number]['p']; slug: string }>();
for (const { c, p } of filas) {
  const clave = p ? JSON.stringify([p.festivos.map((x) => x.fecha), p.gratis?.inicio, p.gratis?.fin, p.opciones.map((o) => [o.inicio, o.fin])]) : 'nada';
  const g = grupos.get(clave) ?? { comunidades: [], p, slug: c.slug };
  g.comunidades.push(c.corto);
  grupos.set(clave, g);
}
const conPuente = [...grupos.values()].filter((g) => g.p).sort((a, b) => b.comunidades.length - a.comunidades.length);
const sinPuente = grupos.get('nada')?.comunidades ?? [];
// Mes del puente con la mejor opción de la comunidad más común marcada.
const ref = conPuente[0];
const mejor = ref?.p?.opciones.at(-1) ?? ref?.p?.gratis;
const mes = Number(f.desde.slice(5, 7)) - 1;
const pedir = new Set(mejor?.fechasPedir ?? []);
const bloque = new Set(mejor ? rango(mejor.inicio, mejor.fin) : []);
const marcas = (d: string): Marca[] => [...(pedir.has(d) ? ['pedir' as const] : []), ...(bloque.has(d) ? ['bloque' as const] : [])];
const calRef = calendario(ANIO, ref ? filas.find((x) => x.c.slug === ref.slug)!.lista : festivos('madrid', ANIO));
const titulo = `Puente de ${f.nombre} ${ANIO}: qué días pedir`;
const breadcrumbs = [{ name: 'Puentes 2027', href: '/puentes-2027' }, { name: f.nombre }];
const otros = PUENTES_2027.filter((x) => x.slug !== f.slug);

// Análisis calculado con los mismos datos (sin fiestas locales).
const total = COMUNIDADES.length;
const conAlgo = filas.filter((x) => x.p);
const lista = (xs: string[]) => (xs.length > 1 ? `${xs.slice(0, -1).join(', ')} y ${xs.at(-1)}` : xs[0] ?? '');
const gratisCom = conAlgo.filter((x) => x.p!.gratis && x.p!.gratis.dias >= 3).map((x) => x.c.corto);
const todasOpc = conAlgo.flatMap((x) => x.p!.opciones.map((o) => ({ c: x.c.corto, o, r: o.dias / o.pedir })));
const mejorR = todasOpc.length ? Math.max(...todasOpc.map((x) => x.r)) : 0;
const delMejor = todasOpc.filter((x) => x.r === mejorR);
const ejemploR = delMejor[0]?.o;
const comMejorR = [...new Set(delMejor.filter((x) => x.o.pedir === ejemploR?.pedir && x.o.dias === ejemploR?.dias).map((x) => x.c))];
const largo = conAlgo.map((x) => ({ c: x.c.corto, v: x.p!.opciones.at(-1) ?? x.p!.gratis })).filter((x) => x.v);
const maxDias = largo.length ? Math.max(...largo.map((x) => x.v!.dias)) : 0;
const delLargo = largo.filter((x) => x.v!.dias === maxDias);
const fmtNum = (n: number) => n.toLocaleString('es-ES', { maximumFractionDigits: 1 });
const deP = /^\d/.test(f.nombre) ? `del ${f.nombre}` : `de ${f.nombre}`;
const dondeTxt = (xs: string[]) => (xs.length === total ? 'toda España' : lista(xs));
const pidiendo = (ds: string[]) => lista(ds.map((d) => `el ${nombreDia(d)} ${fmtMini(d)}`));
// Para los puentes que en 2027 no dan nada: los que sí, ordenados por cuántos territorios cubren.
const otrosRes = otros
  .map((x) => ({ x, n: COMUNIDADES.filter((c) => puenteDe(x, puentes(ANIO, festivos(c.slug, ANIO)))).length }))
  .filter((r) => r.n > 0)
  .sort((a, b) => b.n - a.n)
  .slice(0, 3);
const faqs = [
  {
    q: `¿Qué días hay que pedir para el puente ${deP} de ${ANIO}?`,
    a: mejor
      ? mejor.pedir
        ? `En ${dondeTxt(ref.comunidades)}, pidiendo ${pidiendo(mejor.fechasPedir)} libras ${mejor.dias} días seguidos (${fmtRango(mejor.inicio, mejor.fin)}). En las demás comunidades cambia: lo tienes arriba, comunidad por comunidad.`
        : `En ${dondeTxt(ref.comunidades)} no hace falta pedir nada: son ${mejor.dias} días seguidos (${fmtRango(mejor.inicio, mejor.fin)}).`
      : `En ${ANIO} este puente no da días seguidos que compensen en ningún territorio si libras los fines de semana.`,
  },
  {
    q: `¿En qué comunidades hay festivo entre semana en el puente ${deP}?`,
    a: conAlgo.length === 0
      ? `En ninguna: en ${ANIO} estas fechas caen en fin de semana o no son festivas en ningún territorio del calendario del BOE.`
      : conAlgo.length === total
      ? `En los ${total} territorios del calendario laboral del BOE (17 comunidades, Ceuta y Melilla).`
      : `En ${conAlgo.length} de ${total}: ${lista(conAlgo.map((x) => x.c.corto))}.${sinPuente.length ? ` No lo hay en ${lista(sinPuente)}.` : ''}`,
  },
  {
    q: '¿Y si en mi municipio hay fiesta local esos días?',
    a: 'Cada municipio tiene dos fiestas locales que no salen en esta página. Si una cae junto a este puente, se alarga. Mira las de tu capital en el calendario laboral de tu comunidad.',
  },
];
---

<BaseLayout title={titulo} description={f.resumen.length > 110 ? f.resumen : `${f.resumen} Qué días pedir en tu comunidad para librar más.`} breadcrumbs={breadcrumbs}>
  <CabeceraPagina titulo={titulo} etiqueta={fmtLargo(f.desde)} breadcrumbs={breadcrumbs}>
    <p>{f.resumen}</p>
  </CabeceraPagina>

  <div class="mx-auto max-w-6xl space-y-12 px-4 py-10 sm:px-6">
    {
      mejor && (
        <section class="grid items-start gap-6 lg:grid-cols-[1fr_20rem]">
          <div class="aparece rounded-3xl bg-gradient-to-br from-indigo-700 to-violet-700 p-6 text-white shadow-xl sm:p-8">
            <p class="text-sm font-semibold text-indigo-200">En {ref.comunidades.length === COMUNIDADES.length ? 'toda España' : ref.comunidades.join(', ')}</p>
            <p class="mt-2 text-4xl font-extrabold leading-tight sm:text-5xl">
              {mejor.pedir ? `Pide ${mejor.pedir}, libra ${mejor.dias}` : `${mejor.dias} días sin pedir nada`}
            </p>
            <p class="mt-3 text-lg text-indigo-100">
              {fmtRango(mejor.inicio, mejor.fin)}
              {mejor.pedir > 0 && <> pidiendo {mejor.fechasPedir.map((d) => `el ${nombreDia(d)} ${fmtMini(d)}`).join(' y ')}</>}.
            </p>
          </div>
          <div set:html={anioHtml(calRef, marcas, [mes])} />
        </section>
      )
    }

    <section>
      <h2 class="text-2xl font-bold tracking-tight text-slate-900">Comunidad por comunidad</h2>
      <div class="mt-5 grid gap-4 md:grid-cols-2">
        {
          conPuente.map((g) => (
            <article class="aparece tarjeta">
              <p class="text-sm font-semibold text-indigo-700">{g.comunidades.length === COMUNIDADES.length ? 'Toda España' : g.comunidades.join(' · ')}</p>
              <p class="mt-1 text-sm text-slate-500">{g.p!.festivos.map((x) => `${x.nombre} (${nombreDia(x.fecha)} ${fmtMini(x.fecha)})`).join(', ')}</p>
              <ul class="mt-3 space-y-2 text-sm">
                {g.p!.gratis && <li class="rounded-xl bg-slate-50 p-2.5"><strong>{g.p!.gratis.dias} días</strong> sin pedir nada, {fmtRango(g.p!.gratis.inicio, g.p!.gratis.fin)}.</li>}
                {g.p!.opciones.map((o) => (
                  <li class="rounded-xl bg-emerald-50 p-2.5">
                    Pide <strong>{o.fechasPedir.map((d) => `${nombreDia(d).slice(0, 3)} ${fmtMini(d)}`).join(', ')}</strong> → <strong>{o.dias} días</strong>, {fmtRango(o.inicio, o.fin)}.
                  </li>
                ))}
                {!g.p!.gratis && !g.p!.opciones.length && <li class="rounded-xl bg-slate-50 p-2.5 text-slate-600">Un día suelto, sin puente que compense.</li>}
              </ul>
            </article>
          ))
        }
      </div>
      {sinPuente.length > 0 && <p class="nota mt-5">Sin festivo entre semana en estas fechas: {sinPuente.join(', ')}.</p>}
      <p class="fuente mt-3">Sin fiestas locales, que pueden alargar el puente en tu municipio. Fuente: <a href={FUENTE_BOE[ANIO].url} rel="noopener">BOE {FUENTE_BOE[ANIO].id}</a>.</p>
    </section>


    <section class="max-w-3xl space-y-4 text-slate-700">
      <h2 class="text-2xl font-bold tracking-tight text-slate-900">El puente {deP} de {ANIO}, en cifras</h2>
      <p>
        {conAlgo.length === 0
          ? <>En {ANIO}, ninguno de los {total} territorios del calendario laboral tiene un festivo entre semana en estas fechas, así que con jornada de lunes a viernes este puente no da días libres de más.{otrosRes.length > 0 && <> Los puentes que más territorios cubren este año son {lista(otrosRes.map((r) => `${r.x.nombre} (${r.n} de ${total})`))}.</>}</>
          : conAlgo.length === total
          ? <>Este puente da algún festivo entre semana en los {total} territorios del calendario laboral (17 comunidades, Ceuta y Melilla).</>
          : <>Este puente da algún festivo entre semana en {conAlgo.length} de los {total} territorios del calendario laboral; en los otros {total - conAlgo.length}, o no es festivo o cae en fin de semana.</>}
        {gratisCom.length > 0 && <> Sin pedir ningún día, en {dondeTxt(gratisCom)} ya hay al menos 3 días seguidos libres.</>}
      </p>
      {ejemploR && (
        <p>
          La opción que más rinde es pedir {ejemploR.pedir} {ejemploR.pedir === 1 ? 'día' : 'días'} para librar {ejemploR.dias}: {fmtNum(mejorR)} días libres por cada día de vacaciones, en {dondeTxt(comMejorR)}.
          {maxDias > (ejemploR?.dias ?? 0) && <> El descanso más largo, de {maxDias} días, sale en {dondeTxt([...new Set(delLargo.map((x) => x.c))])}.</>}
        </p>
      )}
      {ejemploR && (
        <p>
          Para hacerte una idea de lo que gastas: las vacaciones mínimas son 30 días naturales al año (artículo 38 del Estatuto de los Trabajadores), que con jornada de lunes a viernes suelen ser unos 22 laborables. Pedir {ejemploR.pedir} {ejemploR.pedir === 1 ? 'día' : 'días'} es gastar {ejemploR.pedir} de esos 22.
        </p>
      )}
      <p class="fuente">Calculado con los festivos del <a href={FUENTE_BOE[ANIO].url} rel="noopener">BOE {FUENTE_BOE[ANIO].id}</a> para quien trabaja de lunes a viernes. No incluye fiestas locales. <a href="/como-hacemos-este-contenido">Cómo lo calculamos</a>.</p>
    </section>

    <section class="max-w-3xl">
      <h2 class="text-2xl font-bold tracking-tight text-slate-900">Preguntas frecuentes</h2>
      <div class="mt-4 space-y-3">
        {faqs.map((x) => (
          <details class="tarjeta" open>
            <summary class="cursor-pointer font-semibold text-slate-900">{x.q}</summary>
            <p class="mt-2 text-slate-700">{x.a}</p>
          </details>
        ))}
      </div>
      <p class="mt-3 text-sm"><a class="font-semibold text-indigo-700 underline" href="/calendario-laboral-2027">Calendario laboral 2027 de tu comunidad, con las fiestas locales de las capitales →</a></p>
    </section>

    <section class="grid gap-3 sm:grid-cols-2">
      {
        CONTEXT_LINKS.map((l) => (
          <a href={`${getProject(l.project).url}${l.path}`} rel="noopener" class="aparece flex items-center justify-between gap-3 rounded-2xl bg-gradient-to-r from-amber-50 to-sky-50 p-5 font-semibold text-slate-800 ring-1 ring-amber-200 transition hover:ring-amber-400">
            {l.text}
            <span aria-hidden="true">→</span>
          </a>
        ))
      }
    </section>

    <section>
      <h2 class="text-xl font-bold text-slate-900">Otros puentes de {ANIO}</h2>
      <ul class="mt-3 flex flex-wrap gap-2">
        {otros.map((x) => <li><a href={`/puentes-2027/${x.slug}`} class="inline-block rounded-full bg-white px-4 py-2 text-sm font-semibold text-slate-800 ring-1 ring-slate-200 hover:bg-indigo-600 hover:text-white">{x.nombre}</a></li>)}
      </ul>
      <a href="/vacaciones" class="boton mt-6">✨ Planifica todo el año con el optimizador</a>
    </section>
  </div>
</BaseLayout>
