---
// Ruta: src/pages/calendario-laboral-2027.astro
// Índice de comunidades y capitales, con un mapa de calor de festivos entre semana.
import BaseLayout from '../layouts/BaseLayout.astro';
import CabeceraPagina from '../components/CabeceraPagina.astro';
import { ANIO, COMUNIDADES, FUENTE_BOE, festivos, festivosComunes, fmtLargo, resumenFestivos, puentes, laborables } from '../lib/festivos';

const filas = COMUNIDADES.map((c) => {
  const l = festivos(c.slug, ANIO);
  return { c, res: resumenFestivos(l), lab: laborables(ANIO, l).total, puentes: puentes(ANIO, l).filter((p) => p.gratis || p.opciones.length).length };
});
const titulo = `Calendario laboral ${ANIO} y festivos ${ANIO} por comunidades`;
// Festivos de toda España, para responder arriba a «festivos 2027»
const comunes = festivosComunes(ANIO);
const breadcrumbs = [{ name: 'Calendario laboral 2027' }];
---

<BaseLayout title={titulo} description={`Elige tu comunidad o tu capital y mira sus festivos de ${ANIO}, sus puentes y los días laborables de cada mes. Con los datos del BOE.`} breadcrumbs={breadcrumbs}>
  <CabeceraPagina titulo={titulo} etiqueta="Datos del BOE" breadcrumbs={breadcrumbs}>
    <p>Festivos {ANIO} en toda España ({comunes.length}): {comunes.map((f, i) => <>{i ? ', ' : ''}<strong>{fmtLargo(f.fecha)}</strong> ({f.nombre})</>)}. Cada comunidad suma los suyos: elígela abajo.</p>
    <p>Las 17 comunidades, Ceuta, Melilla y las 52 capitales de provincia. Fuente: <a class="underline" href={FUENTE_BOE[ANIO].url} rel="noopener">BOE {FUENTE_BOE[ANIO].id}</a>.</p>
  </CabeceraPagina>

  <div class="mx-auto grid max-w-6xl gap-4 px-4 py-10 sm:grid-cols-2 sm:px-6 lg:grid-cols-3">
    {
      filas.map(({ c, res, lab, puentes: np }, i) => (
        <article class="aparece rounded-2xl border border-slate-200 bg-white p-5 shadow-sm transition hover:-translate-y-1 hover:shadow-lg" style={`transition-delay:${(i % 3) * 60}ms`}>
          <a href={`/calendario-laboral-2027/${c.slug}`} class="group flex items-start justify-between gap-3">
            <h2 class="text-lg font-bold text-slate-900 group-hover:text-indigo-700">{c.nombre}</h2>
            <span class="rounded-full bg-indigo-50 px-2.5 py-0.5 text-sm font-bold text-indigo-700">{res.laborables} entre semana</span>
          </a>
          <p class="mt-1 text-sm text-slate-500">{res.total} festivos · {np} puentes · {lab} días laborables</p>
          <ul class="mt-3 flex flex-wrap gap-1.5">
            {c.capitales.map((k) => (
              <li>
                <a href={`/calendario-laboral-2027/${c.slug}/${k.slug}`} class="inline-block rounded-full bg-slate-100 px-2.5 py-1 text-xs font-semibold text-slate-700 transition hover:bg-indigo-600 hover:text-white">
                  {k.nombre}
                </a>
              </li>
            ))}
          </ul>
        </article>
      ))
    }
  </div>
</BaseLayout>
