---
// Ruta: src/pages/es-festivo-manana.astro
// Idea 6: ¿es festivo mañana (u hoy, o el día que elijas) en tu comunidad?
import BaseLayout from '../layouts/BaseLayout.astro';
import CabeceraPagina from '../components/CabeceraPagina.astro';
import SelectorTerritorio from '../components/SelectorTerritorio.astro';
import Faq from '../components/Faq.astro';
import { ANIOS, COMUNIDADES, festivos, hoyMadrid, sumarDias, fmtLargo } from '../lib/festivos';

const titulo = '¿Mañana es festivo?';

// La respuesta de mañana ya va escrita en el HTML (y en el título y la descripción que ve Google).
// El despliegue programado reconstruye la web cada noche; el script de abajo la corrige si va con retraso.
const dondeEs = (fecha: string) =>
  ANIOS.includes(Number(fecha.slice(0, 4)))
    ? COMUNIDADES.map((c) => ({ c, f: festivos(c.slug, Number(fecha.slice(0, 4))).find((x) => x.fecha === fecha) })).filter((x) => x.f)
    : [];
const manana = sumarDias(hoyMadrid(), 1);
const enManana = dondeEs(manana);
const enTodas = enManana.length === COMUNIDADES.length;
const proximo = Array.from({ length: 120 }, (_, i) => sumarDias(manana, i + 1)).find((f) => dondeEs(f).length);
const enProximo = proximo ? dondeEs(proximo) : [];
const frase = (lista: typeof enManana) =>
  lista.length === COMUNIDADES.length
    ? `festivo en toda España (${lista[0].f!.nombre})`
    : `festivo en ${lista.length} ${lista.length === 1 ? 'comunidad' : 'comunidades'}: ${lista.map((x) => x.c.nombre).join(', ')}`;
const respuesta = enManana.length
  ? `Mañana, ${fmtLargo(manana)}, es ${frase(enManana)}.`
  : `Mañana, ${fmtLargo(manana)}, no es festivo en ninguna comunidad.${proximo ? ` El próximo festivo es el ${fmtLargo(proximo)}, ${frase(enProximo)}.` : ''}`;
// El título, con la búsqueda que más impresiones trae: «en qué comunidades es festivo mañana»
const pregunta = '¿En qué comunidades es festivo mañana?';
const soloEn = enManana.length === 1 ? `${pregunta} Solo en ${enManana[0].c.nombre}` : '';
const tituloSeo = !enManana.length
  ? `${pregunta} Lista al día`
  : enTodas
    ? `${pregunta} En toda España`
    : soloEn && soloEn.length <= 60
      ? soloEn
      : `${pregunta} En ${enManana.length}, mira cuáles`;
// La descripción, corta (120-155 caracteres): cuántas comunidades, sin la lista
const cuantas = (n: number) => (n === COMUNIDADES.length ? 'en toda España' : `en ${n} ${n === 1 ? 'comunidad' : 'comunidades'}`);
const corta = enManana.length
  ? `Mañana, ${fmtLargo(manana)}, es festivo ${cuantas(enManana.length)}. Mira si lo es en la tuya o en tu municipio, con los festivos del BOE.`
  : `Mañana, ${fmtLargo(manana)}, no es festivo en ninguna comunidad.${proximo ? ` Próximo festivo: ${fmtLargo(proximo)}.` : ''} Mira tu comunidad o municipio.`;
const descripcion =
  corta.length >= 120 && corta.length <= 155
    ? corta
    : '¿Mañana es festivo? Mira en qué comunidades es fiesta mañana y compruébalo al momento en tu comunidad o tu municipio, con los festivos oficiales del BOE.';
const breadcrumbs = [{ name: '¿Es festivo mañana?' }];
const preguntas = [
  { q: '¿En qué comunidades es festivo mañana?', a: 'La lista de arriba lo dice cada día, con los festivos nacionales y autonómicos del BOE. Las fiestas locales cambian de un municipio a otro: elige el tuyo en el buscador.' },
  { q: '¿Qué festivos tiene en cuenta?', a: `Los nacionales y autonómicos del BOE de ${ANIOS.join(' y ')}, y los locales de los municipios que ya los tienen aprobados. Si tu municipio no sale, puede haber una fiesta local que no vemos.` },
  { q: '¿Este viernes es festivo?', a: 'Más arriba tienes en qué comunidades es festivo el viernes de esta semana, con los festivos nacionales y autonómicos del BOE. Para tu municipio, elige otro día en «¿Y otro día?».' },
  { q: '¿A qué hora cambia de día?', a: 'A medianoche en hora peninsular (Madrid). En Canarias es una hora menos.' },
];
---

<BaseLayout title={tituloSeo} description={descripcion} breadcrumbs={breadcrumbs}>
  <CabeceraPagina titulo={titulo} etiqueta="Al momento" breadcrumbs={breadcrumbs}>
    <p class="text-lg font-semibold" data-respuesta>{respuesta}</p>
    <p>Elige tu comunidad y te decimos si mañana es festivo. Abajo tienes en qué comunidades es fiesta mañana, y puedes preguntar por cualquier otro día.</p>
  </CabeceraPagina>

  <div class="mx-auto max-w-4xl space-y-8 px-4 py-10 sm:px-6">
    <div class="tarjeta"><SelectorTerritorio id="manana" /></div>

    <div class="grid gap-4 sm:grid-cols-2" aria-live="polite">
      {
        ['Mañana', 'Hoy'].map((n) => (
          <div class="rounded-3xl p-6 text-center shadow-xl transition-colors duration-500" data-caja={n}>
            <p class="text-sm font-semibold uppercase tracking-wide opacity-80">{n}</p>
            <p class="cambia mt-2 text-6xl font-black sm:text-7xl" data-si-no>…</p>
            <p class="mt-2 text-lg font-semibold" data-que></p>
            <p class="text-sm mayuscula opacity-80" data-fecha></p>
          </div>
        ))
      }
    </div>

    <section class="tarjeta" aria-live="polite">
      <h2 class="text-xl font-bold text-slate-900">¿En qué comunidades es festivo mañana?</h2>
      <p class="mt-1 text-sm text-slate-500" data-donde-fecha></p>
      <p class="mt-3 text-lg" data-donde>…</p>
      <p class="mt-2 text-sm text-slate-500">Festivos nacionales y autonómicos del BOE. Las fiestas locales dependen de tu municipio.</p>
    </section>

    <section class="tarjeta" aria-live="polite">
      <h2 class="text-xl font-bold text-slate-900">¿Este viernes es festivo?</h2>
      <p class="mt-1 text-sm text-slate-500" data-viernes-fecha></p>
      <p class="mt-3 text-lg" data-viernes>…</p>
    </section>

    <div class="tarjeta">
      <label class="block max-w-xs">
        <span class="etiqueta">¿Y otro día?</span>
        <input type="date" class="entrada" data-otro min={`${ANIOS[0]}-01-01`} max={`${ANIOS.at(-1)}-12-31`} />
      </label>
      <p class="mt-3 text-lg" data-otro-res></p>
    </div>
    <Faq preguntas={preguntas} />
  </div>
</BaseLayout>

<script>
  import { festivos, COMUNIDADES, hoyMadrid, sumarDias, fmtLargo, diaSemana, ETIQUETA_TIPO, ANIOS, conArticulo } from '../lib/festivos';

  let t = { comunidad: 'madrid', municipio: '', isla: '' };
  const otro = document.querySelector<HTMLInputElement>('[data-otro]')!;

  const consulta = (fecha: string) => {
    const f = festivos(t.comunidad, Number(fecha.slice(0, 4)), { municipio: t.municipio, isla: t.isla }).find((x) => x.fecha === fecha);
    const d = diaSemana(fecha);
    return { f, finde: d === 0 || d === 6, sinDatos: !ANIOS.includes(Number(fecha.slice(0, 4))) };
  };

  const pintar = () => {
    const hoy = hoyMadrid();
    for (const [n, fecha] of [['Mañana', sumarDias(hoy, 1)], ['Hoy', hoy]] as const) {
      const caja = document.querySelector<HTMLElement>(`[data-caja="${n}"]`)!;
      const r = consulta(fecha);
      const si = !!r.f;
      caja.className = `rounded-3xl p-6 text-center shadow-xl transition-colors duration-500 ${si ? 'bg-gradient-to-br from-rose-500 to-rose-600 text-white' : r.finde ? 'bg-gradient-to-br from-slate-600 to-slate-700 text-white' : 'bg-white text-slate-900 ring-1 ring-slate-200'}`;
      const sn = caja.querySelector<HTMLElement>('[data-si-no]')!;
      sn.textContent = r.sinDatos ? '¿?' : si ? 'Sí' : 'No';
      sn.classList.remove('cambia');
      void sn.offsetWidth;
      sn.classList.add('cambia');
      caja.querySelector('[data-que]')!.textContent = r.sinDatos
        ? 'Aún no hay calendario oficial de ese año'
        : si
          ? `${r.f!.nombre} · ${ETIQUETA_TIPO[r.f!.tipo]}`
          : r.finde
            ? 'No es festivo, pero es fin de semana'
            : `Día laborable en ${conArticulo(t.comunidad)}`;
      caja.querySelector('[data-fecha]')!.textContent = fmtLargo(fecha);
    }
    if (otro.value) {
      const r = consulta(otro.value);
      document.querySelector('[data-otro-res]')!.innerHTML = r.sinDatos
        ? 'Aún no hay calendario oficial de ese año.'
        : r.f
          ? `🎉 <strong>Sí</strong>: ${fmtLargo(otro.value)} es <strong>${r.f.nombre}</strong> (${ETIQUETA_TIPO[r.f.tipo].toLowerCase()}).`
          : `<strong>No</strong>, ${fmtLargo(otro.value)} no es festivo${r.finde ? ' (es fin de semana)' : ''}.`;
    }
  };
  // Qué comunidades tienen festivo un día (nacional o autonómico; sin fiestas locales)
  const pintarDonde = (fecha: string, sel: string, quien: string) => {
    const manana = fecha;
    const anio = Number(manana.slice(0, 4));
    document.querySelector(`[data-${sel}-fecha]`)!.textContent = `${quien}, ${fmtLargo(manana)}`;
    const res = document.querySelector<HTMLElement>(`[data-${sel}]`)!;
    if (!ANIOS.includes(anio)) {
      res.textContent = 'Aún no hay calendario oficial de ese año.';
      return;
    }
    const con = COMUNIDADES.map((c) => ({ c, f: festivos(c.slug, anio).find((x) => x.fecha === manana) })).filter((x) => x.f);
    const li = (x: (typeof con)[number]) => `<li><strong>${x.c.nombre}</strong>: ${x.f!.nombre}</li>`;
    res.innerHTML = !con.length
      ? `<strong>En ninguna</strong>: ${quien.toLowerCase()} no es festivo nacional ni autonómico. Puede haber fiestas locales en algunos municipios.`
      : con.length === COMUNIDADES.length && con.every((x) => x.f!.tipo === 'nacional')
        ? `<strong>En toda España</strong>: ${con[0].f!.nombre}.`
        : `<ul class="list-disc space-y-1 pl-5">${con.map(li).join('')}</ul>`;
  };
  pintarDonde(sumarDias(hoyMadrid(), 1), 'donde', 'Mañana');
  // Si la página se construyó otro día, la frase de arriba ya no vale: se rehace con el día de hoy
  {
    const dondeEs = (f: string) =>
      ANIOS.includes(Number(f.slice(0, 4))) ? COMUNIDADES.map((c) => ({ c, f: festivos(c.slug, Number(f.slice(0, 4))).find((x) => x.fecha === f) })).filter((x) => x.f) : [];
    const frase = (lista: ReturnType<typeof dondeEs>) =>
      lista.length === COMUNIDADES.length
        ? `festivo en toda España (${lista[0].f!.nombre})`
        : `festivo en ${lista.length} ${lista.length === 1 ? 'comunidad' : 'comunidades'}: ${lista.map((x) => x.c.nombre).join(', ')}`;
    const manana = sumarDias(hoyMadrid(), 1);
    const en = dondeEs(manana);
    const proximo = Array.from({ length: 120 }, (_, i) => sumarDias(manana, i + 1)).find((f) => dondeEs(f).length);
    document.querySelector('[data-respuesta]')!.textContent = en.length
      ? `Mañana, ${fmtLargo(manana)}, es ${frase(en)}.`
      : `Mañana, ${fmtLargo(manana)}, no es festivo en ninguna comunidad.${proximo ? ` El próximo festivo es el ${fmtLargo(proximo)}, ${frase(dondeEs(proximo))}.` : ''}`;
  }
  // El viernes de esta semana (hoy, si es viernes; el siguiente, si ya es fin de semana)
  pintarDonde(sumarDias(hoyMadrid(), (5 - diaSemana(hoyMadrid()) + 7) % 7), 'viernes', 'Este viernes');

  document.addEventListener('territorio', (e) => ((t = (e as CustomEvent).detail), pintar()));
  otro.addEventListener('input', pintar);
</script>
