---
// Ruta: src/pages/calendario-escolar.astro
// Idea 11: cuántos días de vacaciones hay que pedir para cubrir las vacaciones del cole.
// No publicamos fechas escolares: cada familia pone las de su colegio (cambian por comunidad y por centro).
import BaseLayout from '../layouts/BaseLayout.astro';
import CabeceraPagina from '../components/CabeceraPagina.astro';
import SelectorTerritorio from '../components/SelectorTerritorio.astro';
import Leyenda from '../components/Leyenda.astro';
import Faq from '../components/Faq.astro';

const titulo = 'Vacaciones del cole: cuántos días tienes que pedir';
const breadcrumbs = [{ name: 'Vacaciones del cole' }];
const tramos = ['Navidad', 'Semana Santa', 'Otro periodo'];
const preguntas = [
  { q: '¿Dónde miro las fechas del colegio?', a: 'En el calendario escolar que publica la consejería de educación de tu comunidad y, para los días no lectivos propios, en el del propio centro. Cambian de una comunidad a otra y a veces de un municipio a otro.' },
  { q: '¿Por qué no rellenáis vosotros las fechas?', a: 'Porque varían por comunidad, por provincia y por colegio, y preferimos no poner una fecha que no sea la de tu centro. Pon las tuyas y el cálculo es exacto.' },
];
---

<BaseLayout title={`Vacaciones del cole: cuántos días pedir`} description="Pon las vacaciones escolares de tus hijos y tu comunidad: te decimos cuántos días laborables tienes que pedir para cubrirlas y cuáles son." breadcrumbs={breadcrumbs}>
  <CabeceraPagina titulo={titulo} etiqueta="Familias" breadcrumbs={breadcrumbs}>
    <p>Pon las fechas de vacaciones del colegio y dónde trabajas. Te decimos cuántos días laborables caen dentro y cuáles pedir.</p>
  </CabeceraPagina>

  <div class="mx-auto grid max-w-6xl gap-8 px-4 py-10 sm:px-6 lg:grid-cols-[24rem_1fr]">
    <form class="tarjeta h-fit space-y-5" onsubmit="return false" data-form>
      <SelectorTerritorio id="cole" />
      <div class="space-y-3" data-tramos>
        {
          tramos.map((n) => (
            <fieldset class="rounded-xl border border-violet-200 bg-violet-50/50 p-3" data-tramo>
              <input class="mb-2 w-full bg-transparent font-semibold text-violet-900 outline-none" value={n} aria-label="Nombre del periodo" data-nombre />
              <div class="grid grid-cols-2 gap-2">
                <label><span class="ayuda mt-0">Primer día sin cole</span><input type="date" class="entrada py-2 text-sm" min="2026-09-01" max="2027-12-31" data-ini /></label>
                <label><span class="ayuda mt-0">Último día sin cole</span><input type="date" class="entrada py-2 text-sm" min="2026-09-01" max="2027-12-31" data-fin /></label>
              </div>
            </fieldset>
          ))
        }
      </div>
      <button type="button" class="boton-secundario w-full" data-mas>+ Añadir otro periodo</button>
      <p class="ayuda">Puedes poner fechas del curso 2026-2027 y de 2027. Si en casa sois dos, cada uno puede pedir una parte.</p>
    </form>

    <section class="min-w-0 space-y-8" aria-live="polite">
      <div class="grid gap-3 sm:grid-cols-2">
        <div class="rounded-2xl bg-gradient-to-br from-violet-500 to-violet-600 p-5 text-white shadow-lg"><span class="block text-4xl font-extrabold" data-total-cole>—</span>días sin cole</div>
        <div class="rounded-2xl bg-gradient-to-br from-emerald-500 to-emerald-600 p-5 text-white shadow-lg"><span class="block text-4xl font-extrabold" data-total-pedir>—</span>días que tienes que pedir</div>
      </div>
      <ul class="space-y-3" data-lista>
        <li class="rounded-xl bg-slate-50 p-4 text-slate-600">Pon las fechas de al menos un periodo.</li>
      </ul>
      <div>
        <Leyenda extra={['local', 'pedir', 'escolar']} />
        <div class="mt-4 grid gap-3 sm:grid-cols-2 xl:grid-cols-3" data-meses></div>
      </div>
    </section>
  </div>
  <div class="mx-auto max-w-6xl px-4 sm:px-6"><Faq preguntas={preguntas} /></div>
</BaseLayout>

<script>
  import { calendario, festivos, fmtRango, fmtMini, nombreDia, ANIOS } from '../lib/festivos';
  import { anioHtml, rango, type Marca } from '../lib/calendario-html';

  let t = { comunidad: 'madrid', municipio: '', isla: '' };
  const form = document.querySelector<HTMLFormElement>('[data-form]')!;
  const $ = (s: string) => document.querySelector<HTMLElement>(s)!;

  const pintar = () => {
    const cals = Object.fromEntries(ANIOS.map((a) => [a, calendario(a, festivos(t.comunidad, a, { municipio: t.municipio, isla: t.isla }))]));
    const dia = (f: string) => cals[Number(f.slice(0, 4))]?.find((d) => d.fecha === f);
    const tramos = [...form.querySelectorAll<HTMLElement>('[data-tramo]')]
      .map((el) => ({ nombre: el.querySelector<HTMLInputElement>('[data-nombre]')!.value, ini: el.querySelector<HTMLInputElement>('[data-ini]')!.value, fin: el.querySelector<HTMLInputElement>('[data-fin]')!.value }))
      .filter((x) => x.ini && x.fin && x.ini <= x.fin);
    const escolar = new Set<string>();
    const pedir = new Set<string>();
    const html = tramos.map((x, i) => {
      const fechas = rango(x.ini, x.fin);
      fechas.forEach((f) => escolar.add(f));
      const lab = fechas.filter((f) => dia(f) && !dia(f)!.libre);
      lab.forEach((f) => pedir.add(f));
      const sinDatos = fechas.some((f) => !dia(f));
      return `<li class="salta rounded-2xl border border-slate-200 bg-white p-4 shadow-sm" style="animation-delay:${i * 50}ms">
        <div class="flex items-start justify-between gap-3"><p class="font-bold text-slate-900">${x.nombre.replace(/</g, '&lt;')}: ${fmtRango(x.ini, x.fin)}</p><span class="shrink-0 rounded-full bg-emerald-600 px-2.5 py-0.5 text-sm font-bold text-white">pide ${lab.length}</span></div>
        <p class="mt-1 text-sm text-slate-500">${fechas.length} días sin cole, ${fechas.length - lab.length} ya son festivo o fin de semana.${sinDatos ? ' Algunas fechas son de un año sin calendario oficial.' : ''}</p>
        ${lab.length ? `<p class="mt-2 text-sm leading-7">${lab.map((f) => `<span class="rounded-md bg-emerald-50 px-1.5 py-0.5 text-xs font-semibold text-emerald-800">${nombreDia(f).slice(0, 3)} ${fmtMini(f)}</span>`).join(' ')}</p>` : ''}
      </li>`;
    });
    $('[data-lista]').innerHTML = html.join('') || '<li class="rounded-xl bg-slate-50 p-4 text-slate-600">Pon las fechas de al menos un periodo.</li>';
    $('[data-total-cole]').textContent = tramos.length ? String(escolar.size) : '—';
    $('[data-total-pedir]').textContent = tramos.length ? String(pedir.size) : '—';
    const marcas = (f: string): Marca[] => [...(pedir.has(f) ? ['pedir' as const] : []), ...(escolar.has(f) ? ['escolar' as const] : [])];
    const meses = new Map<number, Set<number>>();
    for (const f of escolar) {
      const a = Number(f.slice(0, 4));
      if (!cals[a]) continue;
      if (!meses.has(a)) meses.set(a, new Set());
      meses.get(a)!.add(Number(f.slice(5, 7)) - 1);
    }
    $('[data-meses]').innerHTML = [...meses]
      .sort(([a], [b]) => a - b)
      .map(([a, m]) => anioHtml(cals[a], marcas, [...m].sort((x, y) => x - y)).replace(/(<p class="mb-2[^>]*>)([a-z]+)/g, `$1$2 ${a}`))
      .join('');
  };

  $('[data-mas]').addEventListener('click', () => {
    const base = form.querySelector('[data-tramo]')!.cloneNode(true) as HTMLElement;
    base.querySelectorAll('input').forEach((i) => (i.value = ''));
    base.querySelector<HTMLInputElement>('[data-nombre]')!.value = 'Otro periodo';
    form.querySelector('[data-tramos]')!.append(base);
  });
  document.addEventListener('territorio', (e) => ((t = (e as CustomEvent).detail), pintar()));
  form.addEventListener('input', pintar);
</script>
